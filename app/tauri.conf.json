{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HumanNeeded",
  "version": "0.10.1",
  "identifier": "com.human-needed.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "license": "FSL-1.1-ALv2",
    "copyright": "© 2026 HumanNeeded. FSL-1.1-ALv2.",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBMzBFM0IzQUU1NDNDQTYKUldTbVBGU3VzK013eXJoT2VVcWxQcU5JYmdYdWRvK2c0TERtWGt5bnFZV3lUWU5ETVFEWGpXRHUK",
      "endpoints": [
        "https://github.com/human-needed/app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
